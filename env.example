# Copy this file to .env and fill in your Redis Cloud database credentials.
# One shared database is used for both the coffee-shop lab and the FAQ vector lab
# (free plan = 1 database; keys are separated by prefix: orders:/order:/queue:/leaderboard:
# for the coffee shop, faq: for the vector store).
REDIS_HOST=your-endpoint.redis-cloud.com
REDIS_PORT=12345
REDIS_PASSWORD=your-password-here
REDIS_TLS=false

# Cosine distance cutoff for the FAQ vector search "confident match" check
# (lower = more similar; a query above this is treated as low-confidence).
# Placeholder value - tune against real query results. Adjust and restart
# the server to demo threshold tuning live.
FAQ_DISTANCE_THRESHOLD=0.6

# How long a completed order stays in its "ready for pickup" window (seconds).
# Default 600 (10 min) for realistic use; drop to ~20-30 to demo TTL expiry
# live without waiting 10 minutes.
PICKUP_TTL_SECONDS=600
